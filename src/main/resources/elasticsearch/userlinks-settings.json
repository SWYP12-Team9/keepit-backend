{
  "index": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "max_ngram_diff": 10
  },
  "analysis": {
    "analyzer": {
      "nori": {
        "type": "custom",
        "tokenizer": "nori_tokenizer",
        "filter": [
          "nori_readingform",
          "lowercase",
          "nori_part_of_speech"
        ]
      },
      "nori_search": {
        "type": "custom",
        "tokenizer": "nori_tokenizer",
        "filter": [
          "lowercase",
          "synonym_filter",
          "nori_readingform",
          "nori_part_of_speech"
        ]
      },
      "ngram_analyzer": {
        "type": "custom",
        "tokenizer": "ngram_tokenizer",
        "filter": [
          "lowercase"
        ]
      }
    },
    "tokenizer": {
      "nori_tokenizer": {
        "type": "nori_tokenizer",
        "decompound_mode": "mixed",
        "discard_punctuation": true
      },
      "ngram_tokenizer": {
        "type": "ngram",
        "min_gram": 2,
        "max_gram": 10,
        "token_chars": [
          "letter",
          "digit"
        ]
      }
    },
    "filter": {
      "nori_part_of_speech": {
        "type": "nori_part_of_speech",
        "stoptags": [
          "E",
          "IC",
          "J",
          "MAG",
          "MAJ",
          "MM",
          "SP",
          "SSC",
          "SSO",
          "SC",
          "SE",
          "XPN",
          "XSA",
          "XSN",
          "XSV",
          "UNA",
          "NA",
          "VSV"
        ]
      },
      "synonym_filter": {
        "type": "synonym",
        "lenient": true,
        "synonyms": [
          "개발,프로그래밍,코딩",
          "프론트엔드,frontend,fe",
          "백엔드,backend,be",
          "자바스크립트,javascript,js",
          "타입스크립트,typescript,ts",
          "리액트,react",
          "스프링,spring",
          "데이터베이스,database,db,디비"
        ]
      }
    }
  }
}